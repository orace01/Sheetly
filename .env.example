# Supabase Postgres — Project Settings → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Storage — Project Settings → API
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# Gemini API key for document extraction — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: override the extraction model (defaults to gemini-3.8-flash).
GEMINI_MODEL="gemini-3.8-flash"
