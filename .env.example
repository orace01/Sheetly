# SQLite database (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# Anthropic API key for document extraction — https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional: override the extraction model (defaults to claude-opus-5).
# Sheetly bills per document, so claude-sonnet-5 or claude-haiku-4-5 may be a
# better cost/accuracy trade-off once you're past the beta.
ANTHROPIC_MODEL="claude-opus-5"
